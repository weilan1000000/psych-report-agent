{
  "name": "psych-report-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Expert-guided psychological assessment report generation pipeline",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "app:start": "python -m report_app.server",
    "app:open": "python -m report_app.launcher",
    "app:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop_report_app.ps1",
    "app:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install_report_console_shortcuts.ps1",
    "setup:first-run": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_first_time.ps1",
    "package:colleague": "powershell -ExecutionPolicy Bypass -File ./scripts/build_colleague_package.ps1",
    "app:check-ui": "node ./scripts/check_report_app_ui.js",
    "generate:demo-pdf": "python ./layout_agent.py",
    "render:layout": "node ./renderer/render_layout.js",
    "render:themes": "node ./renderer/render_theme_samples.js",
    "validate:pipeline": "python ./scripts/validate_report_pipeline.py",
    "preview:junior": "python ./scripts/build_junior_high_offline_preview.py",
    "check": "npm test",
    "check:ui": "npm run app:check-ui",
    "clean:cache": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1",
    "test:pipeline": "python -m unittest tests.test_graph_parity tests.test_quality_issues tests.test_feedback_store",
    "test:app": "python -m unittest tests.test_report_app",
    "test": "npm run validate:pipeline && npm run test:pipeline && npm run test:app"
  },
  "keywords": [
    "assessment-report",
    "multi-agent",
    "pdf-generation"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "playwright": "^1.59.1"
  }
}
