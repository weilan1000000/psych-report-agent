{
  "rule_id": "class_rank_20_60_20_v1",
  "reference_group": "同班已完成本次量表的学生",
  "rank_algorithm": {
    "tie_method": "average_rank",
    "percentile_formula": "(cohort_size - average_rank) / (cohort_size - 1) * 100",
    "note": "rank_percentile 越高，表示该指标按其预设方向优于更多同班同学。"
  },
  "level_rules": [
    {
      "level": "潜力区",
      "percentile_condition": "rank_percentile <= 20",
      "parent_label": "位于班级后20%，有较大提升空间"
    },
    {
      "level": "常态区",
      "percentile_condition": "20 < rank_percentile <= 80",
      "parent_label": "处于班级中间60%的稳定阶段"
    },
    {
      "level": "优势区",
      "percentile_condition": "rank_percentile > 80",
      "parent_label": "优于班级约80%的同学"
    }
  ],
  "extreme_score_overrides": [
    {
      "direction": "higher_is_better",
      "score_equals": 100,
      "level": "优势区",
      "percentile_band": "score_ceiling",
      "reason": "该指标达到量表满分，作为优势区处理。"
    },
    {
      "direction": "lower_is_better",
      "score_equals": 0,
      "level": "优势区",
      "percentile_band": "score_floor_favorable",
      "reason": "该指标在有利方向达到量表最低分，作为优势区处理。"
    }
  ],
