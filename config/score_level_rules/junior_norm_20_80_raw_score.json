  "direction_rule": "For higher_is_better metrics, raw <= P20 is 潜力区 and raw >= P80 is 优势区. For lower_is_better metrics such as 负性情绪, raw <= P20 is 优势区 and raw >= P80 is 潜力区.",
  "chart_rule": {
    "score_source": "students_scores first worksheet raw score",
    "display": "Each detailed metric chart uses one horizontal three-segment band per metric: 潜力区, 常态区, 优势区. Mark the student's raw score with an arrow. Do not print the numeric raw score on the arrow."
  },
  "level_rules": [
    {
      "level": "潜力区",
      "condition": "higher_is_better and raw_score <= norm_p20; or lower_is_better and raw_score >= norm_p80"
    },
    {
      "level": "常态区",
      "condition": "norm_p20 < raw_score < norm_p80"
    },
    {
      "level": "优势区",
      "condition": "higher_is_better and raw_score >= norm_p80; or lower_is_better and raw_score <= norm_p20"
    }
  ],
